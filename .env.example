# Three-bank example:
# - primary uses the supplied simulator on localhost:8080
# - mock and simulated intentionally return bank-unavailable (HTTP 503)
PGW_BANKS='[{"bank_id":"primary","base_url":"http://localhost:8080"},{"bank_id":"mock","mock_unavailable":true},{"bank_id":"simulated","mock_unavailable":true}]'

# Stable card-hash routing. Keep the same bank order as the configured bank IDs.
PGW_ROUTING='{"bank_ids":["primary","mock","simulated"]}'
